{
  "name": "wesley-ukadike-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "js-yaml": "4.3.1",
    "smol-toml": "1.7.1",
    "undici": "7.29.0",
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --no-deprecation",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:budgets": "node scripts/check-budgets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:budgets"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@sanity/presentation": "^2.0.0",
    "@sanity/vision": "^6.10.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "nuxt": "^4.5.2",
    "nuxt-schema-org": "^6.3.0",
    "nuxt-site-config": "^4.1.5",
    "postcss": "^8.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/sanity": "^2.5.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@vueuse/core": "^14.4.0",
    "motion-v": "^2.3.0",
    "vue": "^3.5.41"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@oxc-minify/binding-linux-x64-gnu": "0.143.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.143.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.143.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "@rollup/rollup-linux-x64-gnu": "4.62.4",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
