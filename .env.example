# Public site identity
NUXT_PUBLIC_SITE_URL=https://example.com

# Google reCAPTCHA v3 (site key is public; secret is server-only)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_RECAPTCHA_SECRET_KEY=

# EmailJS REST credentials (all consumed by the Nitro server only)
NUXT_EMAILJS_SERVICE_ID=
NUXT_EMAILJS_TEMPLATE_ID=
NUXT_EMAILJS_PUBLIC_KEY=
NUXT_EMAILJS_PRIVATE_KEY=

# Optional Sanity visual editing. Leave disabled for ordinary production traffic.
NUXT_SANITY_VISUAL_EDITING=false
NUXT_SANITY_API_READ_TOKEN=
NUXT_SANITY_STUDIO_URL=
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional server-side JSON error webhook
NUXT_MONITORING_WEBHOOK_URL=
